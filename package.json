{
  "name": "whatsapp-ia",
  "version": "1.0.0",
  "description": "Respostas automáticas no WhatsApp com agentes de IA",
  "author": "Seu Nome",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": { "qrcode": "^1.5.3", "whatsapp-web.js": "^1.26.0" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.meuapp.whatsappia",
    "productName": "WhatsApp IA",
    "files": ["main.js", "preload.js", "renderer/**/*", "package.json"],
    "mac": { "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }], "category": "public.app-category.business" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "publish": [{ "provider": "github", "releaseType": "release" }]
  }
}
